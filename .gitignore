# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/master/Unity.gitignore
#
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

.idea/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.unitypackage

# Crashlytics generated file
crashlytics-build.properties

# Unity user settings
UserSettings/

Docs/

CLAUDE.md
.mcp.json

Tools/

# Android NDK build output
/.utmp/
GEMINI.md
Assets/Screenshots/
Assets/Screenshots.meta
/.agents

# Firebase / External Dependency Manager generated output (regenerated by Android Resolver)
/[Aa]ssets/GeneratedLocalRepo/
/[Aa]ssets/GeneratedLocalRepo.meta

# Firebase desktop-only native plugins (over 75 MB each, not used on Android)
/[Aa]ssets/Firebase/Plugins/x86_64/FirebaseCppApp-*.bundle
/[Aa]ssets/Firebase/Plugins/x86_64/FirebaseCppApp-*.so

# Profiler captures and auto-generated performance test run files
/ProfilerCaptures/
/[Aa]ssets/Resources/PerformanceTestRun*.json
/[Aa]ssets/Resources/PerformanceTestRun*.json.meta

# Firebase config (contains project id and API key)
/[Aa]ssets/DataTracking/
/[Aa]ssets/DataTracking.meta
/[Aa]ssets/StreamingAssets/google-services*.json
/[Aa]ssets/StreamingAssets/google-services*.json.meta
/[Aa]ssets/Plugins/Android/FirebaseApp.androidlib/res/values/google-services.xml
/[Aa]ssets/Plugins/Android/FirebaseApp.androidlib/res/values/google-services.xml.meta
google-services*.json

# Signing material
*.keystore
*.jks
*.p12
*.pem

# AI assistant files
/.claude/
.claude/
CLAUDE.md
GEMINI.md
.gemini/

# Misc generated
/state/
/UserSettings/
*.slnx
*.DotSettings.user
